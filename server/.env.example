# ----------------------------------------------------------------------
# PrepNova Server — Environment Variables (copy to `.env` and fill in)
# ----------------------------------------------------------------------

# HTTP
PORT=5000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# For a frontend hosted on a separate site, use HTTPS and set this to `none`.
COOKIE_SAME_SITE=lax

# --- PostgreSQL connection ---
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=prepnova

# --- JWT ---
# Use a long random string in production: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=7AjSwZZ3JjLj7pddRhXqj2mGcmIN4Q7ioAexmjIdeNp
JWT_EXPIRES_IN=7d

# --- Initial administrator (used by `npm run db:admin`) ---
INITIAL_ADMIN_NAME=Admin_Aswin
INITIAL_ADMIN_EMAIL=aswin@admin.prepnova
INITIAL_ADMIN_PASSWORD=aswinadm123

# --- AI Evaluation (provider-agnostic) ---
# Copy this file to .env, then set AI_API_KEY to a key from your chosen provider.
# The key stays on the backend and is never sent to the browser.
AI_PROVIDER=gemini            # openai | gemini | anthropic
AI_MODEL=gemini-3.8-flash
AI_API_KEY=replace_with_api_key
AI_TIMEOUT_MS=30000
AI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe

# Gemini alternative (provider-specific defaults are used when AI_MODEL/AI_BASE_URL are omitted):
# AI_PROVIDER=gemini
# AI_MODEL=gemini-3.8-flash
# AI_API_KEY=replace_with_gemini_api_key

# Anthropic alternative:
# AI_PROVIDER=anthropic
# AI_MODEL=claude-haiku-4-5-20251001
# AI_API_KEY=replace_with_anthropic_api_key
